FROM mcr.microsoft.com/playwright/python:v1.62.0-noble@sha256:aa81288e738725378becba5b3e06cb0f3a7f012a610e87e8d767a090ea3f740d
RUN pip install --no-cache-dir playwright==1.62.0
WORKDIR /opt/tempo-acceptance
RUN mkdir tempo
COPY tempo/acceptance_contract.py tempo/acceptance_harness.py tempo/preview_files.py tempo/preview_server.py ./tempo/
ENV PYTHONPATH=/opt/tempo-acceptance PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
ARG TEMPO_GIT_SHA=unknown
LABEL org.opencontainers.image.revision=$TEMPO_GIT_SHA
