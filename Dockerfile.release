FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends iptables util-linux \
    && rm -rf /var/lib/apt/lists/*
RUN mkdir tempo
COPY tempo/preview_files.py tempo/preview_server.py tempo/release_files.py tempo/release_server.py ./tempo/
COPY --chmod=0755 scripts/preview-entrypoint.sh /usr/local/bin/tempo-static-entrypoint
ARG TEMPO_GIT_SHA=unknown
LABEL org.opencontainers.image.revision=$TEMPO_GIT_SHA
ENTRYPOINT ["/usr/local/bin/tempo-static-entrypoint", "staging"]
