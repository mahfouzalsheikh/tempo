# Copy this file to .env before starting Tempo. Never commit real secret values.

# Required for the checked-in GitHub tracker and repository hooks.
GITHUB_TOKEN=

# Use either an API key here or an authenticated Codex login in tempo-codex-home.
OPENAI_API_KEY=

# Replace these local defaults before exposing Tempo outside your machine.
DJANGO_SECRET_KEY=replace-with-a-long-random-value
TEMPO_POSTGRES_PASSWORD=tempo-local

# Local runtime preferences.
TEMPO_PORT=8030
TEMPO_LOG_LEVEL=INFO
TEMPO_TIME_ZONE=UTC

# Optional: creates the initial Django superuser when both fields are set.
TEMPO_ADMIN_USERNAME=
TEMPO_ADMIN_PASSWORD=
TEMPO_ADMIN_EMAIL=
